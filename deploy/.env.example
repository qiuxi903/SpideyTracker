# 寻找小蜘蛛 部署配置
# 数据库连接（使用服务器自带的 MySQL，不启动容器）
DB_HOST=127.0.0.1
DB_PORT=3306
# 数据库用户名与密码（你服务器 MySQL 的账号）
DB_USER=spidey
DB_PASS=
DB_NAME=spidey_tracker
# JWT 签名密钥（随机生成，请勿泄露；修改后所有用户需重新登录）
JWT_SECRET=
# 邮箱服务器（SMTP）配置：SMTP_ENABLED=true 并填写以下项后，注册验证码会发真实邮件；留 false 则打印到容器日志
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=寻找小蜘蛛 <no-reply@yourdomain.com>
