# 寻找小蜘蛛 部署配置
# 数据库用户名（非 root，可自定义，默认 spidey；如使用 tooy 则填 tooy）
DB_USER=spidey
# 数据库密码（部署时设置）
DB_PASS=
# JWT 签名密钥（随机生成，请勿泄露；修改后所有用户需重新登录）
JWT_SECRET=
# 邮箱服务器（SMTP）配置：SMTP_ENABLED=true 并填写以下项后，注册验证码会发真实邮件；留 false 则打印到容器日志
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=寻找小蜘蛛 <no-reply@yourdomain.com>
